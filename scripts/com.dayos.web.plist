<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dayos.web</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/montrose/Developer/GitRepositories/daily-operating-system/.venv/bin/uvicorn</string>
        <string>dayctl.server.app:create_app</string>
        <string>--factory</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/montrose/Developer/GitRepositories/daily-operating-system</string>

    <!-- Generate a token with `openssl rand -hex 24` and paste it here. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>DAYCTL_TOKEN</key>
        <string>&lt;DAYCTL_TOKEN&gt;</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- Start on login and restart if it crashes. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/dayos-web.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dayos-web.log</string>
</dict>
</plist>
